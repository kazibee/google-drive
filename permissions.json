{
  "net": [
    "www.googleapis.com",
    "oauth2.googleapis.com"
  ],
  "env": {
    "CLIENT_ID": "CLIENT_ID",
    "CLIENT_SECRET": "CLIENT_SECRET",
    "REFRESH_TOKEN": "REFRESH_TOKEN"
  },
  "methods": {

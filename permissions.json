    "createGoogleDoc": { "read": true, "write": true },
    "uploadTextFile": { "read": true, "write": true },
    "updateTextFile": { "read": true, "write": true },
    "moveFile": { "read": true, "write": true },
    "deleteFile": { "read": true, "write": true }
  }
}
